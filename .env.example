# Copy to .env for local development. Every variable is optional; the defaults
# below are what the server uses when a variable is unset. The full reference
# is apps/server/README.md ("Configuration for authentication" and
# "Configuration for content").

# Server
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# NODE_ENV=production   # stops the Swagger UI being served

# The public origin browsers use. Its scheme decides the session cookie's
# Secure flag and __Host- prefix, HSTS, and which Origin the CSRF check
# accepts. Plain http is permitted only for localhost (ADR-011).
#
# Set to the Vite dev server's origin for local development: the browser
# talks to :5173, which proxies /api to :3000 (apps/web/vite.config.ts), so
# :5173 is the Origin the CSRF check must accept. A deployment sets its own
# real public origin here instead.
APP_URL=http://localhost:5173

# What is in front of the server, if anything (ADR-011).
#
# Rate limiting keys on the source address, so a believed X-Forwarded-For from
# an untrusted peer is an unlimited budget from one host — and the header is
# therefore ignored entirely unless this says otherwise. Set it to the number
# of proxies between the internet and this process, or to the exact addresses
# and CIDR ranges to believe. The blanket "true" is refused. The same setting
# decides whether a caller-supplied X-Request-Id is honoured.
# TRUST_PROXY=1
# TRUST_PROXY=10.0.0.0/8,192.168.1.5

# Database. Every deployment sets this explicitly; the default matches
# docker-compose.yml. Under NODE_ENV=production the server refuses to boot
# without it, rather than quietly pointing at a local database.
DATABASE_URL=postgres://quill:quill@localhost:5432/quill

# Content store (ADR-014): one bare repository per workspace on disk.
# "memory" keeps the same layout in process, for tests and throwaway instances.
CONTENT_STORE=filesystem
CONTENT_STORE_PATH=./data/content

# The instance master key (ADR-034). It wraps the data key of every secret an
# administrator enters in the product — OIDC client secrets, SMTP passwords,
# integration tokens — and it is the one thing a restore cannot rebuild from
# the content store.
#
# On a laptop (an APP_URL on localhost) it may be left unset: the server uses
# the all-zero key below and says so. Any instance whose APP_URL is not
# loopback refuses to boot without an explicit one — and refuses this one by
# value, because it is published here and is not a secret.
#
# Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# QUILL_MASTER_KEY=
#
# Rotating it: add the new key here, keep the old one in the list below,
# restart, run `pnpm --filter @quill/server secrets:rotate`, then drop the
# old key. The rotation re-wraps data keys and never touches a ciphertext.
# QUILL_MASTER_KEY_PREVIOUS=     # comma-separated; retired keys, unwrap only
#
# Or keep the keys in a file on a mounted volume, one base64 key per line,
# current first, with `#` comments allowed.
# MASTER_KEY_DRIVER=file
# QUILL_MASTER_KEY_FILE=/run/secrets/master-key   # chmod 600; wider is refused
#
# Who the rotation is attributed to in the audit trail, when it is run from a
# deployment script rather than by somebody at a keyboard.
# SECRETS_ROTATE_ACTOR=

# Sessions (ADR-011): absolute lifetime and idle lifetime, in milliseconds.
# SESSION_TTL_MS=2592000000        # 30 days
# SESSION_IDLE_TTL_MS=604800000    # 7 days
# SESSION_COOKIE_NAME=             # defaults to __Host-<slug>_session over https
#                                  # must keep the __Host- prefix on an https
#                                  # instance; the server refuses to boot otherwise

# Rate limiting on the auth endpoints, per source address and per account.
# The window doubles for a key that keeps failing, up to the maximum.
# AUTH_RATE_LIMIT_MAX=10
# AUTH_RATE_LIMIT_WINDOW_MS=60000
# AUTH_RATE_LIMIT_MAX_WINDOW_MS=3600000
# Search has its own, larger budget per session, counted in the same window.
# SEARCH_RATE_LIMIT_MAX=60

# Breached-password check (HIBP k-anonymity). Set to false on an air-gapped
# instance. The range URL is also the outbound client's entire allowlist.
# BREACHED_PASSWORD_CHECK=true
# BREACHED_PASSWORD_RANGE_URL=https://api.pwnedpasswords.com/range

# Share links (plan section 14). "off" refuses to create new links AND closes
# every link that already exists, on the next request: the setting is asked
# again on every use rather than cached, so turning it off is immediate.
#
# This belongs to the organisation's settings, where an administrator can
# change it — and set the maximum role a link may carry — without a restart.
# It is an environment variable until the settings store lands, so that the
# policy is enforced from the first release rather than retrofitted onto links
# people already hold.
# SHARE_LINKS=on

# Single sign-on with OpenID Connect (ADR-011).
#
# OIDC_PROVIDERS names the providers this instance offers, in the order the
# sign-in page shows them. Each id then has its own OIDC_<ID>_* variables,
# with the id upper-cased and its hyphens turned into underscores. A provider
# that does not make sense refuses to boot rather than failing when somebody
# presses its button.
#
# OIDC_PROVIDERS=entra,google
#
# Common to every provider:
#   OIDC_<ID>_PRESET          entra | google-workspace | cognito | auth0 | generic
#                             (default: generic)
#   OIDC_<ID>_CLIENT_ID       required
#   OIDC_<ID>_CLIENT_SECRET   required. TODO(M3): this becomes the *name* of a
#                             secret held by the settings store's secrets API
#                             (setSecret / getSecret, envelope-encrypted under
#                             the instance master key); until an administrator
#                             has entered it there, it is the value itself.
#   OIDC_<ID>_DISPLAY_NAME    what the button says after "Continue with"
#                             (default: the preset's own name)
#   OIDC_<ID>_SCOPES          space- or comma-separated; must include openid
#                             (default: openid email profile)
#   OIDC_<ID>_ALLOW_SIGN_UP   false to refuse people with no account here
#                             rather than creating one (default: true)
#   OIDC_<ID>_ALLOW_LINKING   false to refuse to attach an identity to an
#                             account that already exists (default: true).
#                             Even with it true, linking needs the local
#                             account to have verified that address itself:
#                             otherwise anyone could sign up as somebody
#                             else's work address, never open the mail, and
#                             be handed the account the first time the real
#                             owner pressed "Continue with Microsoft".
#   OIDC_<ID>_EMAIL_CLAIM, OIDC_<ID>_EMAIL_VERIFIED_CLAIM,
#   OIDC_<ID>_NAME_CLAIM, OIDC_<ID>_GROUPS_CLAIM
#                             claim mapping overrides; the preset supplies the
#                             defaults, including where groups live
#
# Per preset, the fields the issuer is derived from:
#   entra             OIDC_<ID>_TENANT_ID      the directory (tenant) id. The
#                     issuer is the tenant-specific one and `tid` is checked
#                     against it, so the multi-tenant "common" endpoint can
#                     never sign somebody in from another directory.
#   google-workspace  OIDC_<ID>_HOSTED_DOMAIN  the Workspace domain. Sent as
#                     `hd` on the request and checked on the token.
#   cognito           OIDC_<ID>_REGION and OIDC_<ID>_USER_POOL_ID
#   auth0             OIDC_<ID>_DOMAIN         e.g. acme.eu.auth0.com
#   generic           OIDC_<ID>_ISSUER         stated outright; must be https
#
# Register this redirect URI with the provider, per provider id:
#   <APP_URL>/api/auth/oidc/<id>/callback
#
# The two sign-in endpoints share one budget per source address, per minute,
# and it is flat: it never doubles the way the password endpoints' does. They
# are keyed only by address, so a whole office behind one NAT is a single key
# and a small backing-off budget would lock the building out on a Monday
# morning; and they cannot be usefully brute-forced anyway, because `start`
# mints a fresh secret every time and `callback` needs the cookie this browser
# was given. The budget is there to bound the outbound traffic a stranger can
# make this server produce. A completed sign-in clears it.
# OIDC_RATE_LIMIT_MAX=300
#
# OIDC_ENTRA_PRESET=entra
# OIDC_ENTRA_TENANT_ID=
# OIDC_ENTRA_CLIENT_ID=
# OIDC_ENTRA_CLIENT_SECRET=
# OIDC_GOOGLE_PRESET=google-workspace
# OIDC_GOOGLE_HOSTED_DOMAIN=example.com
# OIDC_GOOGLE_CLIENT_ID=
# OIDC_GOOGLE_CLIENT_SECRET=

# Mail. "dev" logs sign-in, verification and reset links to stdout instead of
# sending them, and is for local development only: under NODE_ENV=production
# the server refuses to boot with it (ADR-011).
MAIL_DRIVER=dev
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_FROM=
# SMTP_USER=
# SMTP_PASS=

# The seed (`pnpm --filter @quill/server seed`) writes accounts with known
# passwords and overwrites them on every run, so it refuses under
# NODE_ENV=production unless this says the operator meant it.
# SEED_ALLOW_PRODUCTION=1
