{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "singleQuote": true,
  "semi": false,
  "trailingComma": "all",
  "ignorePatterns": [
    "**/dist/**",
    "**/coverage/**",
    "**/node_modules/**",
    "pnpm-lock.yaml",
    "**/*.gen.*",
    "**/*.md",
    "spikes/**",
    "**/*.dc.html"
  ]
}
