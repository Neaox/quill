{
  "name": "@quill/server",
  "version": "0.0.0",
  "private": true,
  "description": "Quill HTTP server: API, public-site rendering, background jobs.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node --env-file-if-exists=../../.env src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "export-openapi": "node src/scripts/export-openapi-cli.ts",
    "seed": "node --env-file-if-exists=../../.env src/scripts/seed-cli.ts",
    "seed:demo": "node --env-file-if-exists=../../.env src/scripts/seed-cli.ts --demo",
    "db:reset": "node --env-file-if-exists=../../.env src/scripts/reset-database-cli.ts",
    "e2e:serve": "node src/scripts/reset-database-cli.ts && node src/scripts/seed-oidc-fake-secret-cli.ts && node src/main.ts",
    "oembed:sync": "node src/scripts/sync-oembed-providers-cli.ts",
    "reindex": "node --env-file-if-exists=../../.env src/scripts/reindex-cli.ts",
    "secrets:rotate": "node --env-file-if-exists=../../.env src/scripts/rotate-secrets-cli.ts",
    "secrets:set": "node --env-file-if-exists=../../.env src/scripts/secrets-set-cli.ts",
    "e2e:fake-oidc": "node src/scripts/fake-oidc-server-cli.ts",
    "bench:link-preview": "node src/infrastructure/link-preview/link-preview.bench.ts",
    "bench:search": "node --env-file-if-exists=../../.env src/infrastructure/search/search.bench.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@node-rs/argon2": "^2.2.1",
    "@quill/application": "workspace:*",
    "@quill/brand": "workspace:*",
    "@quill/content-store": "workspace:*",
    "@quill/design-css": "workspace:*",
    "@quill/domain": "workspace:*",
    "@quill/highlight": "workspace:*",
    "@quill/markdown": "workspace:*",
    "@quill/search": "workspace:*",
    "@quill/theme": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "ajv": "^8.20.0",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.3",
    "nodemailer": "^10.0.3",
    "parse5": "^8.0.1",
    "pg": "^8.23.0",
    "remeda": "^2.48.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@quill/config": "workspace:*",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10"
  }
}
