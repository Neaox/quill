{
  "name": "@quill/format",
  "version": "0.0.0",
  "private": true,
  "description": "Quill's DocumentFormat adapter: parsing, rendering and inspecting a document with @quill/markdown, as the server and the command-line tool both run it (ADR-062).",
  "license": "MIT",
  "type": "module",
  "exports": {
