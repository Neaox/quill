{
  "name": "@quill/design-css",
  "version": "0.0.0",
  "private": true,
  "description": "The plain-CSS half of the design system: the reading grid, reading typography, and the public site's own furniture. No dependencies, so a server can serve it without installing a component library.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./lightbox": "./src/lightbox/lightbox.ts",
    "./image-viewer": "./src/lightbox/images.ts",
    "./code-blocks": "./src/code-blocks/code-blocks.ts",
    "./copy": "./src/code-blocks/copy.ts",
    "./details": "./src/details/details.ts",
    "./contents-spy": "./src/contents-spy/contents-spy.ts",
    "./animated-images": "./src/animated-images/animated-images.ts",
    "./tables": "./src/tables/tables.ts",
    "./layout.css": "./src/layout.css",
    "./prose.css": "./src/prose.css",
    "./byline.css": "./src/byline.css",
    "./comparison.css": "./src/comparison.css",
    "./public-site.css": "./src/public-site.css"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "generate:reader": "node scripts/generate-reader.ts"
  },
  "devDependencies": {
    "@quill/config": "workspace:*",
    "@quill/highlight": "workspace:*",
    "@quill/markdown": "workspace:*",
    "rolldown": "^1.2.8"
  }
}
