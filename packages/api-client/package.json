{
  "name": "@quill/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Typed client for the server's HTTP API, generated from its OpenAPI description. The web app talks to the server only through this package.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "generate": "openapi-typescript openapi.gen.json --output src/schema.gen.d.ts --alphabetize --root-types"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@quill/config": "workspace:*",
    "openapi-typescript": "^7.13.0",
    "typescript": "^6.0.3"
  }
}
